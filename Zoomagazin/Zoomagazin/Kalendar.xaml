<Page x:Class="Zoomagazin.Kalendar"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
      xmlns:local="clr-namespace:Zoomagazin"
      mc:Ignorable="d" 
      d:DesignHeight="680" d:DesignWidth="1200"
      Title="Kalendar">

    <Grid Background="#eff2f7">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="График рабочих смен" Grid.Row="1" FontSize="32" FontWeight="SemiBold" Margin="0 20 0 0"
           HorizontalAlignment="Left" Foreground="#3AB19B"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SaveButton" Style="{StaticResource addButton}" Click="SaveButton_Click" Width="30" Margin="0 20 10 0" Visibility="{Binding _editButtonsVisibility}">
                <StackPanel Orientation="Horizontal">
                    <Icon:PackIconMaterial Kind="ContentSaveAll" VerticalAlignment="Center" Width="11" Height="11" />
                </StackPanel>
            </Button>

            <Button x:Name="AddButton" Click="AddGrapf" Style="{StaticResource addButton}" Width="100" Margin="0 20 20 0" Visibility="{Binding _editButtonsVisibility}">
                <StackPanel Orientation="Horizontal">
                    <Icon:PackIconMaterial Kind="Plus" VerticalAlignment="Center" Width="11" Height="11" Margin="0 1 8 0"/>
                    <TextBlock Text="Добавить"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource addButton}" Click="EditButton_Click" Width="120">
                <StackPanel Orientation="Horizontal">
                    <Icon:PackIconMaterial Kind="Pencil" VerticalAlignment="Center" Width="11" Height="11" Margin="0 1 8 0"/>
                    <TextBlock Text="Редактировать"/>
                </StackPanel>
            </Button>

            <Button x:Name="Obnov" Style="{StaticResource addButton}" Click="Obnovaa" Width="30" Margin="20 20 10 0" >
                <StackPanel Orientation="Horizontal">
                    <Icon:PackIconMaterial Kind="Refresh" VerticalAlignment="Center" Width="11" Height="11" />
                </StackPanel>
            </Button>
        </StackPanel>


        <Separator Height="1" Grid.Row="3" Background="#dae2ea" Margin="0 10 0 0"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0 10 0 0">
            <Button Width="150" Content="Академическая, 27" Style="{StaticResource tabButton}" Click="Button1_Click"/>
            <Button Width="150" Content="Гоголя, 44В"  Style="{StaticResource tabButton}" Click="Button2_Click"/>
        </StackPanel>

        <Grid Grid.Row="5" Margin="10">
            <Border CornerRadius="20" Background="#E7EAEA">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0">
                        <TextBlock  FontSize="20" FontWeight="SemiBold" Margin="10 10 0 0"
                        HorizontalAlignment="Left" Foreground="#3AB19B" x:Name="CurrentMonthTextBlock"/>

                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right">
                        <ComboBox Margin="0 0 20 0"
                                x:Name="MonthComboBox"
                                  Width="150"
                                  materialDesign:HintAssist.Hint="Выберите месяц"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}">
                            <ComboBoxItem Content="Январь" />
                            <ComboBoxItem Content="Февраль" />
                            <ComboBoxItem Content="Март" />
                            <ComboBoxItem Content="Апрель" />
                            <ComboBoxItem Content="Май" />
                            <ComboBoxItem Content="Июнь" />
                            <ComboBoxItem Content="Июль" />
                            <ComboBoxItem Content="Август" />
                            <ComboBoxItem Content="Сернтябрь" />
                            <ComboBoxItem Content="Октябрь" />
                            <ComboBoxItem Content="Ноябрь" />
                            <ComboBoxItem Content="Декабрь" />
                        </ComboBox>
                    </StackPanel>


                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Width="500" Grid.Row="1" Grid.Column="0">
                                <DataGrid Style="{DynamicResource DataGridStyle1}"
                  CellStyle="{DynamicResource DataGridCellStyle1}" 
                  ColumnHeaderStyle="{DynamicResource DataGridColumnHeaderStyle1}" 
                  RowStyle="{DynamicResource DataGridRowStyle1}"
                  x:Name="GrafDataGrid"
                  AutoGenerateColumns="False"
                  Width="490"
                  HorizontalAlignment="Stretch">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Сотрудник" IsReadOnly="True" Width="*" Binding="{Binding Employees.FullName}" />
                                    <DataGridTextColumn Header="Дата работы" IsReadOnly="True" Width="*" Binding="{Binding Date, StringFormat='{}{0:dd.MM.yyyy}'}"/>
                                    <DataGridTemplateColumn Header="Операции" IsReadOnly="True" Width="Auto" Visibility="{Binding _operationsColumnVisibility}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Style="{StaticResource gridEditButton}" Click="Button_Click_Edit">
                                                        <Icon:PackIconMaterial Kind="PencilOutline" Style="{StaticResource gridButtonIcon}"/>
                                                    </Button>
                                                    <Button Style="{StaticResource gridEditButton}" Click="Deletez" Background="Red">
                                                        <Icon:PackIconMaterial Kind="DeleteOutline" Style="{StaticResource gridButtonIcon}"/>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </ScrollViewer>
                        


                    <Grid Grid.Column="1" Grid.Row="1" Margin="10">
                        <Grid>
                            <lvc:CartesianChart Series="{Binding SeriesCollection}" LegendLocation="Left">
                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis Title="Сотрудники" Labels="{Binding Labels}"></lvc:Axis>
                                </lvc:CartesianChart.AxisX>
                                <lvc:CartesianChart.AxisY>
                                    <lvc:Axis Title="Количество отработанных смен" LabelFormatter="{Binding Formatter}"></lvc:Axis>
                                </lvc:CartesianChart.AxisY>
                            </lvc:CartesianChart>
                        </Grid>
                    </Grid>

                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
