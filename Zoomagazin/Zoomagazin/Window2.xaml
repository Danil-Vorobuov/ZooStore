<Window x:Class="Zoomagazin.Window2"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks" 
                xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True"
                Background="Transparent" Height="450" Width="450">
    <Grid>

        <Icon:PackIconMaterial Kind="Close" Grid.Column="1" Panel.ZIndex="1" Mouse.MouseUp="Icon_MouseUp" Style="{StaticResource iconClose}"/>

        <Border Grid.Column="1" CornerRadius="20" Background="#ffffff">
            <StackPanel>
                <TextBlock Text="Редактирование товара" Style="{StaticResource titleText}" Foreground="#3AB19B" FontSize="30"/>
                <TextBox x:Name="Nazvanie1"
                                  VerticalAlignment="Top" Margin="70 10 70 15"
                                  materialDesign:HintAssist.HelperText="Название"
                                  materialDesign:HintAssist.Hint="Название товара"
                                  Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                <TextBox x:Name="Opicanie1"
                                  VerticalAlignment="Top" Margin="70 10 70 15"
                                  materialDesign:HintAssist.HelperText="Описание"
                                  materialDesign:HintAssist.Hint="Описание товара"
                                  TextWrapping="Wrap"
                                  Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                <TextBox x:Name="Cena1"
                                  VerticalAlignment="Top" Margin="70 10 70 15"
                                  materialDesign:HintAssist.HelperText="Цена"
                                  materialDesign:HintAssist.Hint="Цена товара"
                                  TextWrapping="Wrap"
                                  Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                <TextBox x:Name="Kolvo1"
                                  VerticalAlignment="Top" Margin="70 10 70 15"
                                  materialDesign:HintAssist.HelperText="Количество"
                                  materialDesign:HintAssist.Hint="Количество тавара"
                                  TextWrapping="Wrap"
                                  Style="{StaticResource MaterialDesignOutlinedTextBox}"/>



                <Button Content="Сохранить" Click="Button_Click" Style="{StaticResource mainbutton}"/>


            </StackPanel>
        </Border>

    </Grid>
</Window>
