<Window x:Class="Zoomagazin.AddUsers"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Height="500" Width="450" Title="Добавление пользователя">
    <Grid>

        <Icon:PackIconMaterial Kind="Close" Grid.Column="1" Panel.ZIndex="1" Mouse.MouseUp="Icon_MouseUp" Style="{StaticResource iconClose}"/>

        <Border Grid.Column="1" CornerRadius="20" Background="White">
            <StackPanel>
                <TextBlock Text="Добавление пользователя" FontSize="27" Style="{StaticResource titleText}" Foreground="#3AB19B"/>

                <TextBox x:Name="FIO"
                     VerticalAlignment="Top" Margin="70 10 70 15"
                     materialDesign:HintAssist.HelperText="ФИО сотрудника"
                     materialDesign:HintAssist.Hint="Фамилия Имя Отчество"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                <TextBox x:Name="username"
                     VerticalAlignment="Top" Margin="70 10 70 15"
                     materialDesign:HintAssist.HelperText="Имя пользователя"
                     materialDesign:HintAssist.Hint="Имя"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                <TextBox x:Name="password"
                     VerticalAlignment="Top" Margin="70 10 70 15"
                     materialDesign:HintAssist.HelperText="Пароль"
                     materialDesign:HintAssist.Hint="Пароль"
                     TextWrapping="Wrap"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                <TextBox x:Name="emaile"
                     VerticalAlignment="Top" Margin="70 10 70 15"
                     materialDesign:HintAssist.HelperText="Email"
                     materialDesign:HintAssist.Hint="Электронная почта"
                     TextWrapping="Wrap"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                <ComboBox
                Width="310" Margin="70 10 70 0"
                materialDesign:HintAssist.Hint="Выберите должность"
                materialDesign:TextFieldAssist.HasClearButton="True"
                ItemsSource="{Binding ShortStringList}"
                Style="{StaticResource MaterialDesignOutlinedComboBox}"
                x:Name="Position">
                    <ComboBoxItem Content="Директор" />
                    <ComboBoxItem Content="Сотрудник" />
                    <ComboBoxItem Content="Администратор" />
                </ComboBox>

                <Button Width="270" Content="Добавить добавить пользователя" Click="Button_Click" Style="{StaticResource mainbutton}"/>

            </StackPanel>
        </Border>
    </Grid>
</Window>
