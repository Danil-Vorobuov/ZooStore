<Window x:Class="Zoomagazin.Vhod"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Height="300" Width="450">

    <Window.Resources>
        <Storyboard x:Key="SlideAnimation">
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Svaip1" Storyboard.TargetProperty="Visibility">
                <DiscreteObjectKeyFrame KeyTime="0:0:0.3" Value="{x:Static Visibility.Collapsed}" />
            </ObjectAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Svaip" Storyboard.TargetProperty="Visibility">
                <DiscreteObjectKeyFrame KeyTime="0:0:0.3" Value="{x:Static Visibility.Visible}" />
            </ObjectAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Svaip" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Window.Resources>

    <Grid>

        <Icon:PackIconMaterial Mouse.MouseUp="Icon_MouseUp" Kind="Close" Grid.Column="1"  Panel.ZIndex="1" Style="{StaticResource iconClose}" />

        <Border Grid.Column="1" CornerRadius="20" Background="#ffffff">
            <StackPanel Orientation="Vertical">

                <TextBlock Text="Добро пожаловать" Style="{StaticResource titleText}" Foreground="#3AB19B"/>

                <Grid x:Name="MainGrid">

                    <StackPanel Orientation="Vertical" Margin="60 0" x:Name="Svaip1" Visibility="Visible">

                        <TextBox Margin="20"
                          x:Name="UsernameTextBox"
                          materialDesign:HintAssist.HelperText="Логин"
                          materialDesign:HintAssist.Hint="User name"
                          Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                        <PasswordBox Margin="20 10"
                          x:Name="PasswordTextBox"           
                          materialDesign:HintAssist.HelperText="Пароль"
                          materialDesign:HintAssist.Hint="Password"
                          Style="{StaticResource MaterialDesignOutlinedPasswordBox}"/>

                        <Button Content="Далее" Click="Svvapinge" Style="{StaticResource mainbutton}"/>

                    </StackPanel>

                    <StackPanel Orientation="Vertical" Margin="60 0 60 10" x:Name="Svaip" Visibility="Collapsed">

                        <TextBlock TextWrapping="Wrap" Foreground="Black" Text="Вам на почту отправлен временный код! Введите его, иначе он устареет." 
                                   FontSize="14" Style="{StaticResource titleText}"/>

                        <TextBox Margin="80 20 80 0"
                          x:Name="RandomeCode" 
                          materialDesign:HintAssist.HelperText="Временный код"
                          materialDesign:HintAssist.Hint="Code"
                          Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        <Button Content="Отправить повторно" Click="Povtorka" FontSize="10" Style="{StaticResource mainbutton}" Height="45" Width="128"/>
                        <Button Margin="0 8 0 0" Content="Войти" Click="Vhodvsistem" Style="{StaticResource mainbutton}"/>

                    </StackPanel>


                </Grid>


            </StackPanel>
        </Border>

    </Grid>

</Window>
