<Page x:Class="Zoomagazin.Analis"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
      xmlns:local="clr-namespace:Zoomagazin"
      mc:Ignorable="d" 
      d:DesignHeight="680" d:DesignWidth="1200"
      Title="Kalendar">

    <Grid Background="#eff2f7">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Поставки" Grid.Row="1" FontSize="32" FontWeight="SemiBold" Margin="0 20 0 0"
           HorizontalAlignment="Left" Foreground="#3AB19B"/>

       

        
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="1">
             <Button Style="{StaticResource addButton}" Click="PostButton_Click" Width="100" Margin="0 20 20 0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="+Поставщик"/>
            </StackPanel>
        </Button>
            <Button Style="{StaticResource addButton}" Click="EditButton_Click" Width="150">
            <StackPanel Orientation="Horizontal">
                <Icon:PackIconMaterial Kind="BookAlert" VerticalAlignment="Center" Width="11" Height="11" Margin="0 1 8 0"/>
                <TextBlock Text="История поставок"/>
            </StackPanel>
        </Button>
        
        </StackPanel>
        <Separator Height="1" Grid.Row="3" Background="#dae2ea" Margin="0 10 0 0"/>

        <Grid Grid.Row="5" Margin="10">
            <Border CornerRadius="20" Background="#E7EAEA">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="1" Grid.Column="0" Width="500" HorizontalAlignment="Left" Margin="10">
                        <DataGrid Style="{DynamicResource DataGridStyle1}" 
          CellStyle="{DynamicResource DataGridCellStyle1}" 
          ColumnHeaderStyle="{DynamicResource DataGridColumnHeaderStyle1}" 
          RowStyle="{DynamicResource DataGridRowStyle1}" 
          Grid.Row="1" Grid.Column="0" 
          x:Name="Postavka"
          ItemsSource="{Binding Products}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Название товара" IsReadOnly="True" Width="Auto" Binding="{Binding Name}" />
                                <DataGridTextColumn Header="Количество" IsReadOnly="True" Width="Auto" Binding="{Binding Quantity}" />
                            </DataGrid.Columns>
                        </DataGrid>

                    </StackPanel>

                    <Grid Grid.Column="1" Grid.Row="1" Margin="10">
                        <StackPanel>
                            <TextBox x:Name="Nazvanie" Width="250"
                                  VerticalAlignment="Top" Margin="70 0 70 15"
                                  materialDesign:HintAssist.HelperText="Название"
                                  materialDesign:HintAssist.Hint="Название товара"
                                  Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                            <TextBox x:Name="Kolvo" Width="250"
                                  VerticalAlignment="Top" Margin="70 10 70 15"
                                  materialDesign:HintAssist.HelperText="Количество"
                                  materialDesign:HintAssist.Hint="Количество тавара"
                                  TextWrapping="Wrap"
                                  Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                            <Button
                                    Margin="5 5 5 0"
                                    Height="40" Click="AddButton_Click"
                                    Width="150"
                                    Background="#3AB19B" 
                                    materialDesign:ButtonAssist.CornerRadius="20"
                                    IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                    Style="{StaticResource MaterialDesignRaisedDarkButton}"
                                    BorderThickness="0"
                                    ToolTip="MaterialDesignRaisedDarkButton with Round Corners">
                                <TextBlock Text="Добавить"/>
                            </Button>
                            <Button
                                    Margin="5 15 5 0"
                                    Height="40" Click="ClearButton_Click"
                                    Width="150"
                                    Background="#3AB19B" 
                                    materialDesign:ButtonAssist.CornerRadius="20"
                                    IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                    Style="{StaticResource MaterialDesignRaisedDarkButton}"
                                    BorderThickness="0"
                                    ToolTip="Очистить форму">
                                <TextBlock Text="Очистить форму"/>
                            </Button>

                            <DatePicker 
                                    x:Name="DatePicker"
                                    Width="250" Margin="70 30 70 0"
                                    materialDesign:HintAssist.HelperText="Выберите дату"
                                    materialDesign:HintAssist.Hint="Дата"
                                    Background="Transparent"
                                    Style="{StaticResource MaterialDesignOutlinedDatePicker}" />

                            <ComboBox
                                Width="250" Margin="70 30 70 0"
                                materialDesign:HintAssist.Hint="Торговая точка"
                                materialDesign:TextFieldAssist.HasClearButton="True"
                                Background="Transparent"
                                ItemsSource="{Binding SalesPoints}"
                                Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                DisplayMemberPath="Address"
                                SelectedValuePath="id_T"
                                TextSearch.TextPath="Address"
                                x:Name="Point">
                            </ComboBox>

                            <ComboBox
                                Width="250" Margin="70 30 70 0"
                                materialDesign:HintAssist.Hint="Поставщик"
                                materialDesign:TextFieldAssist.HasClearButton="True"
                                Background="Transparent"
                                ItemsSource="{Binding Suppliers}"
                                DisplayMemberPath="Name"
                                SelectedValuePath="Id"
                                TextSearch.TextPath="Name"
                                Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                x:Name="Poct">
                            </ComboBox>
                            <Button
                                    Margin="5 25 5 0"
                                    Height="40"
                                    Width="150"
                                    Click="CreateExcelButton_Click"
                                    Background="#3AB19B"
                                    materialDesign:ButtonAssist.CornerRadius="20"
                                    IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                    Style="{StaticResource MaterialDesignRaisedDarkButton}"
                                    BorderThickness="0"
                                    ToolTip="Создать заявку напоставку">
                                <TextBlock Text="Создать заявку"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        
    </Grid>
</Page>

