<Window x:Class="Zoomagazin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Height="720" Width="1450" WindowStartupLocation="CenterScreen" WindowStyle="None" 
        AllowsTransparency="True" Background="Transparent">

    <Window.Resources>
        
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="SelectedMenuButton" TargetType="Button" BasedOn="{StaticResource menuButton}">
            <Setter Property="Background" Value="#2E8D7C" />
            <Setter Property="Foreground" Value="White" />
        </Style>

    </Window.Resources>

    <Border Background="#eff2f7" CornerRadius="30" MouseDown="Border_MouseDown" MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Grid>
            <Grid>
                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="174*"/>
                        <ColumnDefinition Width="451*"/>
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>


                        <Button Style="{StaticResource topButton}" Margin="20 28 0 35" Click="EdditUserProfil" Background="#dcdcdc">
                            <Icon:PackIconMaterial Kind="Cog"/>
                        </Button>
                        <Button Style="{StaticResource topButton}" Margin="60 28 0 35" Click="Rasrab" Background="#dcdcdc">
                            <Icon:PackIconMaterial Kind="AccountStar"/>
                        </Button>

                        <Border Grid.Row="1" Background="#3AB19B" CornerRadius="0 50 0 30">
                            <DockPanel>
                                <Border Width="80" Height="80" Padding="3" Background="White" CornerRadius="100"
                                    DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="20 -30 0 0">
                                    <Ellipse>
                                        <Ellipse.Fill>
                                            <ImageBrush x:Name="userPhoto" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </Border>
                                <TextBlock x:Name="usernameTextBlock" Foreground="White" FontSize="14" FontWeight="SemiBold"
                                    DockPanel.Dock="Top" TextAlignment="Center" Margin="5 25 0 10"/>


                                <TextBlock Text="ЗооМир № 1" Foreground="White" FontSize="14" FontWeight="SemiBold"
                        DockPanel.Dock="Top" TextAlignment="Center" />

                                <Separator Margin="25" DockPanel.Dock="Top" Height="0.8" Background="White"/>

                                <StackPanel DockPanel.Dock="Top">
                                    <Button x:Name="Page2Button" Style="{StaticResource menuButton}" Click="Page2">
                                        <StackPanel Orientation="Horizontal">
                                            <Icon:PackIconMaterial Kind="HomeVariant" Style="{StaticResource menuButtomIcon}"/>
                                            <TextBlock Text="Главная"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="Page1Button" Style="{StaticResource menuButton}" Click="Page1">
                                        <StackPanel Orientation="Horizontal">
                                            <Icon:PackIconMaterial Kind="Calendar" Style="{StaticResource menuButtomIcon}"/>
                                            <TextBlock Text="График"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="PageOfButton" Style="{StaticResource menuButton}" Click="PageOf">
                                        <StackPanel Orientation="Horizontal">
                                            <Icon:PackIconMaterial Kind="Dog" Style="{StaticResource menuButtomIcon}"/>
                                            <TextBlock Text="Товары"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="PostavkaAddButton" Style="{StaticResource menuButton}" Click="PostavkaAdd">
                                        <StackPanel Orientation="Horizontal">
                                            <Icon:PackIconMaterial Kind="PencilBox" Style="{StaticResource menuButtomIcon}"/>
                                            <TextBlock Text="Заявка"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="AnalyticsButton" Style="{StaticResource menuButton}" Click="Button_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Icon:PackIconMaterial Kind="Abacus" Style="{StaticResource menuButtomIcon}"/>
                                            <TextBlock Text="Аналитика"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="PageAdminButton" Style="{StaticResource menuButton}" Click="UsersOpenWindow">
                                        <StackPanel Orientation="Horizontal">
                                            <Icon:PackIconMaterial Kind="Nativescript" Style="{StaticResource menuButtomIcon}"/>
                                            <TextBlock Text="Пользователь"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <Button Style="{StaticResource menuButton}" VerticalAlignment="Bottom" DockPanel.Dock="Bottom" Margin="15 0 15 20" Click="ClosedWindow">
                                    <StackPanel Orientation="Horizontal">
                                        <Icon:PackIconMaterial Kind="Logout" Style="{StaticResource menuButtomIcon}"/>
                                        <TextBlock Text="Выйти"/>
                                    </StackPanel>
                                </Button>

                            </DockPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Column="1" Margin="30,20,20,20" Grid.ColumnSpan="2">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Категории товаров" Grid.Row="1" FontSize="32" FontWeight="SemiBold" Margin="0 20 0 0"
                           HorizontalAlignment="Left" Foreground="#3AB19B"/>
                        
                        <Button Style="{StaticResource addButton}" Click="AddPerehod">
                            
                            <StackPanel Orientation="Horizontal">
                                <Icon:PackIconMaterial Kind="Plus" VerticalAlignment="Center" Width="11" Height="11" Margin="0 1 8 0"/>
                                <TextBlock Text="Добавить товар"/>
                            </StackPanel>
                        </Button>

                        <Separator Height="1" Grid.Row="3" Background="#dae2ea" Margin="0 10 0 0"/>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0 10 0 0">
                            <Button Content="Все" Style="{StaticResource tabButton}" Tag="0" Click="CategoryButton_Click"/>
                            <Button Content="Корма" Style="{StaticResource tabButton}" Tag="1" Click="CategoryButton_Click"/>
                            <Button Content="Аксессуары" Style="{StaticResource tabButton}" Width="100" Tag="3" Click="CategoryButton_Click"/>
                            <Button Content="Игрушки" Style="{StaticResource tabButton}" Width="84" Tag="2" Click="CategoryButton_Click"/>
                            <Button Content="Для грызунов" Style="{StaticResource tabButton}" Width="121" Tag="4" Click="CategoryButton_Click"/>
                            
                        </StackPanel>

                        <TextBlock Text="Товары" Grid.Row="4" FontSize="18" FontWeight="SemiBold"
                           Foreground="#3AB19B" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                        <TextBlock Text="Поиск по товарам" Grid.Row="4" FontSize="13" FontWeight="SemiBold" Margin="0 0 215 0"
                           Foreground="#121518" HorizontalAlignment="Right" VerticalAlignment="Center"/>


                        <Grid Width="200" HorizontalAlignment="Right" Grid.Row="4">
                            <TextBlock Margin="15 0" VerticalAlignment="Center" Foreground="#b0b9c6" IsHitTestVisible="False"
                               Panel.ZIndex="1" Text="Введите название товара ..." 
                               Visibility="{Binding ElementName=txtFilter, Converter={StaticResource BoolToVis}}" />

                            <TextBox x:Name="txtFilter" Style="{StaticResource textboxFilter}" TextChanged="txtFilter_TextChanged"/>
                        </Grid>

                        <DataGrid  Style="{DynamicResource DataGridStyle1}" CellStyle="{DynamicResource DataGridCellStyle1}" ColumnHeaderStyle="{DynamicResource DataGridColumnHeaderStyle1}" RowStyle="{DynamicResource DataGridRowStyle1}" Grid.Row="5" x:Name="membersDataGrid" SelectionChanged="membersDataGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn CanUserResize="False" Width="auto" ElementStyle="{StaticResource CheckBoxStyle1}">
                                    <DataGridCheckBoxColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <CheckBox Style="{StaticResource CheckBoxStyle1}"/>
                                        </DataTemplate>
                                    </DataGridCheckBoxColumn.HeaderTemplate>
                                </DataGridCheckBoxColumn>

                                <DataGridTextColumn Header="ID" IsReadOnly="True" CanUserResize="False" Width="auto" Binding="{Binding ID}"/>


                                <DataGridTextColumn Header="Название" IsReadOnly="True" Width="350" Binding="{Binding Название}" />
                                <DataGridTextColumn Header="Описание" IsReadOnly="True" Width="400" Binding="{Binding описание}"/>
                                <DataGridTextColumn Header="Цена" IsReadOnly="True" Width="100" Binding="{Binding цена}"/>
                                <DataGridTextColumn Header="Количество" IsReadOnly="True" Width="100" Binding="{Binding Кол_воТовара}"/>

                                <DataGridTemplateColumn Header="Операции" IsReadOnly="True" Width="auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource gridEditButton}" Click="EditPere">
                                                    <Icon:PackIconMaterial Kind="PencilOutline" Style="{StaticResource gridButtonIcon}"/>
                                                </Button>
                                                <Button Style="{StaticResource gridRemoveButton}" Click="DeleteZ">
                                                    <Icon:PackIconMaterial Kind="DeleteOutline" Style="{StaticResource gridButtonIcon}"/>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Row="6" HorizontalAlignment="Right" BorderBrush="#dee4ec" BorderThickness="1"
                        CornerRadius="5" Padding="5" Background="White" Margin="0 10 10 10">
                            <StackPanel Orientation="Horizontal">

                                <Button Style="{StaticResource pagingButton}" Click="Obnov">
                                    <Icon:PackIconMaterial Kind="Refresh" Style="{StaticResource padingButtonIcon}"/>
                                </Button>

                                <Rectangle Width="1" Fill="#dee4ec" Margin="3 7"/>

                                <Button Style="{StaticResource pagingButton}" Click="Print">
                                    <Icon:PackIconMaterial Kind="PrinterAlert" Style="{StaticResource padingButtonIcon}"/>
                                </Button>

                            </StackPanel>
                        </Border>

                    </Grid>

                    <Grid Grid.Column="1" Margin="30,20,20,20" Grid.ColumnSpan="2">
                        <Frame x:Name="mainFrame" Style="{StaticResource NoNavigationFrameStyle}"/>
                    </Grid>
                </Grid>
            </Grid>

            <Grid x:Name="DimBackground" Visibility="Collapsed" Background="Black" Opacity="0.5" MouseLeftButtonDown="AnotherWindow_Closed"/>
        </Grid>
    </Border>
</Window>

    