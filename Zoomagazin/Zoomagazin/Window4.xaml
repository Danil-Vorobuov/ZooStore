<Window x:Class="Zoomagazin.Window4"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:local="clr-namespace:Zoomagazin"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        Background="Transparent" Height="380" Width="450" AllowsTransparency="True" >

    <Border Grid.Column="1" CornerRadius="20" Background="#3AB19B">
        <Grid>

            <Icon:PackIconMaterial Kind="Close" Grid.Column="1" Width="15" Height="15" Foreground="White" Panel.ZIndex="1" Mouse.MouseUp="Icon_MouseUp" Style="{StaticResource iconClose}"/>

            <StackPanel Margin="10 20 ">
                <TextBlock Text="Добавление месяца" Style="{StaticResource titleText}" FontSize="25" Foreground="White"/>

                <ComboBox Width="200" Margin="70 25 70 0"
          materialDesign:HintAssist.Hint="Месяц"
          materialDesign:TextFieldAssist.HasClearButton="True"
          Background="White"
          ItemsSource="{Binding ShortStringList}"
          Style="{StaticResource MaterialDesignOutlinedComboBox}"
          x:Name="Cotrudnik">
                    <ComboBoxItem>Январь</ComboBoxItem>
                    <ComboBoxItem>Февраль</ComboBoxItem>
                    <ComboBoxItem>Март</ComboBoxItem>
                    <ComboBoxItem>Апрель</ComboBoxItem>
                    <ComboBoxItem>Май</ComboBoxItem>
                    <ComboBoxItem>Июнь</ComboBoxItem>
                    <ComboBoxItem>Июль</ComboBoxItem>
                    <ComboBoxItem>Август</ComboBoxItem>
                    <ComboBoxItem>Сентябрь</ComboBoxItem>
                    <ComboBoxItem>Октябрь</ComboBoxItem>
                    <ComboBoxItem>Ноябрь</ComboBoxItem>
                    <ComboBoxItem>Декабрь</ComboBoxItem>
                </ComboBox>

                <ComboBox Width="200" Margin="70 15 70 0"
          materialDesign:HintAssist.Hint="Торговая точка"
          materialDesign:TextFieldAssist.HasClearButton="True"
          Background="White"
          ItemsSource="{Binding ShortStringList}"
          Style="{StaticResource MaterialDesignOutlinedComboBox}"
          x:Name="Point">
                    <ComboBoxItem>Академическая, 27</ComboBoxItem>
                    <ComboBoxItem>Гоголя, 44В</ComboBoxItem>
                </ComboBox>

                <TextBox x:Name="Prib"
         Width="200"
         VerticalAlignment="Top" Margin="70 10 70 15"
         Background="White"
         materialDesign:HintAssist.HelperText="Прибыль"
         materialDesign:HintAssist.Hint="Прибыль"
         TextWrapping="Wrap"
         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                <Button Content="Добавить" Foreground="#3AB19B" Background="White" Click="Button_Click" Style="{StaticResource mainbutton}"/>



            </StackPanel>

        </Grid>
    </Border>

</Window>
